    "categorical_pipeline = Pipeline(steps=[ \n",
    "    (\"imputer\", SimpleImputer(strategy=\"constant\", fill_value=\"Unknown\")), \n",
    "    (\"encoder\", OneHotEncoder(handle_unknown=\"ignore\")) \n",
    "])\n",
    "categorical_pipeline"
   ]
