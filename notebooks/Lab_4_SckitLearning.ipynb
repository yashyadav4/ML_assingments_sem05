    "#Creating Full Pipeline\n",
    "model_pipeline = Pipeline(steps=[ \n",
    "    (\"preprocessor\", preprocessor), \n",
    "    (\"model\", LogisticRegression(max_iter=1000, class_weight=\"balanced\")) \n",
    "]) \n",
    "model_pipeline"
   ]
